# LLM Provider Configuration
# Supported options: "local_mock" (default offline simulator), "ollama", "openai_compatible"
LLM_PROVIDER=local_mock

# Ollama Settings (if using local Ollama service)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# OpenAI Compatible Settings (optional, leave blank for local mock or ollama)
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=

# Retrieval & Level 1 Feedback Settings
RELEVANCE_THRESHOLD=0.65
MAX_RETRIEVAL_RETRIES=3
TOP_K_DOCUMENTS=4

# Generation & Level 2 Feedback Settings
GROUNDEDNESS_THRESHOLD=0.75
COMPLETENESS_THRESHOLD=0.70
MAX_GENERATION_RETRIES=2

# Level 3 System & Memory Feedback Settings
DATABASE_PATH=feedback_store.db
ENABLE_GOLDEN_CACHE=true
SIMILARITY_CACHE_THRESHOLD=0.92
DYNAMIC_WEIGHT_INCREMENT=0.10

# API Settings
HOST=0.0.0.0
PORT=8000

